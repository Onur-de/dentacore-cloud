# Bu dosyayı .env olarak kopyalayın. .env dosyasını asla paylaşmayın veya git'e eklemeyin.
DOMAIN=klinikadi.com
ACME_EMAIL=it@klinikadi.com

POSTGRES_USER=dentacore
POSTGRES_PASSWORD=degistir-uzun-rastgele
REDIS_PASSWORD=degistir-uzun-rastgele
N8N_ENCRYPTION_KEY=degistir-uzun-rastgele

# Hasta telefonu ve anamnez cevapları bu anahtarla şifrelenir (Fernet). Üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Telefon numarasını aranabilir yapmak için HMAC anahtarı (rastgele uzun metin)
PHONE_HMAC_KEY=degistir-uzun-rastgele
# Yönetim uç noktaları (randevu, bekleme listesi, işlem kaydı) için başlık: X-Admin-Token
ADMIN_TOKEN=degistir-uzun-rastgele

# İlk açılışta otomatik oluşturulacak klinik yöneticisi hesabı (/app paneli girişi; parola en az 12 karakter)
OWNER_EMAIL=yonetici@klinikadi.com
OWNER_PASSWORD=degistir-en-az-12-karakter
AVG_TICKET_TRY=3500

# Instagram DM kanalı (isteğe bağlı, resmi Instagram Graph API)
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=degistir-uzun-rastgele

# Yedekler age ile şifrelenir. Anahtar çifti: age-keygen -o yedek-anahtari.txt  (gizli anahtarı sunucu DIŞINDA saklayın)
BACKUP_AGE_PUBLIC_KEY=age1...

# --- Resmi Meta WhatsApp Cloud API (EvolutionAPI gibi resmi olmayan köprüler kullanılmaz) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=degistir-uzun-rastgele
WA_GRAPH_VERSION=v21.0
# 24 saat penceresi dışında gönderim için Meta'da onaylatılmış şablon adları
WA_TPL_WAITLIST=bekleme_listesi_teklif
WA_TPL_POSTOP=islem_sonrasi_kontrol
WA_TPL_REMINDER=randevu_hatirlatma
WA_TPL_PLAN_FOLLOWUP=tedavi_plani_takip
WA_TPL_FEEDBACK=deneyim_talebi
WA_TPL_ANAMNESIS=anamnez_formu
WA_TPL_BRIEF=hekim_ozet
WA_TPL_LANG=tr

# Sabah özeti doluluk hesabı
CHAIRS=2
WORK_MINUTES=600
DOCTOR_DISPLAY_NAME=Dt. Ad Soyad

# Uyarıların gideceği numaralar (E.164, örn +905321112233)
DOCTOR_ON_CALL_PHONE=
DOCTOR_OWNER_PHONE=

# --- LLM / OmniRoute AI Gateway (ücretsiz kota duyarlı free-auto + fallback, veya OpenAI/vLLM) ---
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=omniroute-local
LLM_SMALL_MODEL=free-auto
LLM_MAIN_MODEL=free-auto
LLM_MAX_TOKENS=180
# Semantik önbellek için embedding modeli (boşsa semantik katman kapalı, kesin eşleşme önbelleği çalışır)
EMBED_MODEL=text-embedding-3-small
SEMANTIC_THRESHOLD=0.92

# Fiyat paylaşımı varsayılan KAPALI (Sağlık tanıtım mevzuatı). Açmadan önce avukat onayı alın.
PRICE_DISCLOSURE=off

# --- Hekim sesi (isteğe bağlı). Yalnızca hekimin YAZILI onayıyla ve hastaya açıklama ile kullanılır ---
VOICE_PROVIDER=off
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Google ---
GOOGLE_REVIEW_URL=https://g.page/r/XXXX/review
CLINIC_NAME=Örnek Ağız ve Diş Sağlığı Polikliniği

ORTHANC_USER=pacs
ORTHANC_PASSWORD=degistir-uzun-rastgele
